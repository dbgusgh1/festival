{
  "rules": {
    "rooms": {
      "$r": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (!data.exists() || data.child('owner').val() === auth.uid)"
        },
        "pub":  { ".read": "auth != null", ".write": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid" },
        "st":   { ".read": "auth != null", ".write": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid" },
        "grid": { ".read": "auth != null", ".write": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid" },
        "img":  { ".read": "auth != null", ".write": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid" },
        "sc":   { ".read": "auth != null", ".write": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid" },
        "cmd":  {
          ".read":  "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid"
        },
        "priv": {
          ".read":  "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid"
        },
        "pv": {
          "$pid": {
            ".read":  "auth != null && auth.uid === $pid",
            ".write": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid"
          }
        },
        "players": {
          ".read": "auth != null",
          "$pid": { ".write": "auth != null && (auth.uid === $pid || root.child('rooms').child($r).child('meta/owner').val() === auth.uid)" }
        },
        "in": {
          ".read": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid",
          "$pid": { ".write": "auth != null && auth.uid === $pid" }
        },
        "ev": {
          ".read": "auth != null && root.child('rooms').child($r).child('meta/owner').val() === auth.uid",
          "$pid": {
            ".write": "auth != null && auth.uid === $pid",
            ".validate": "newData.child('at').val() === now"
          }
        }
      }
    },
    "teachers": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "shared": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      "$type": {
        "$id": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)))"
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    }
  }
}
